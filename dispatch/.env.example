# Copia este archivo a `dispatch/.env` (ignorado por git) y completa lo que uses.
# Estos scripts publican de verdad en tus redes: pruébalos primero con una cuenta de pruebas.

# ── Bluesky (AT Protocol) ──
# Bluesky > Settings > Privacy and Security > App Passwords > Add App Password.
BLUESKY_IDENTIFIER=tu-usuario.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── X (Twitter) ── OAuth 1.0a de usuario.
# developer.x.com > Projects & Apps > tu app > Keys and tokens.
# El Access Token/Secret debe generarse con permiso "Read and Write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
