# Social Hub — variables de entorno
#
# Copia este archivo a `.env.local` (lo ignora git) y completa lo que vayas a usar.
# Todo es opcional: sin Firebase el hub corre SIN login; sin Drive no hay portadas ni archivos; cada red se activa
# solo cuando pones sus credenciales. Guía paso a paso de cada una: docs/credenciales.md.
# Los valores marcados (SECRETO) nunca van al repo, a un chat ni a una captura.

# ── Marca (docs/adaptacion.md) ───────────────────────────────────────────────
# Nombre y wordmark del topbar, login y pestañas. El wordmark son dos palabras: "Social" + "Hub".
NEXT_PUBLIC_BRAND_NAME=Social Hub
NEXT_PUBLIC_BRAND_PRIMARY=Social
NEXT_PUBLIC_BRAND_SECONDARY=Hub
# Texto de la firma en portadas e historias generadas (normalmente tu dominio)
NEXT_PUBLIC_BRAND_SIGNATURE=tu-dominio.com
# Dominio de correo que puede entrar (Google Workspace), sin la arroba. Vacío = cualquier cuenta de Google.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# ── Firebase Auth + Firestore ────────────────────────────────────────────────
# Firebase Console → Configuración del proyecto → Tus apps → app web → "Configuración del SDK".
# Son identificadores públicos (no secretos). Sin API_KEY el hub corre sin login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Base de datos de Firestore. Vacío = "(default)". Pon el nombre si creaste una base con nombre.
NEXT_PUBLIC_FIRESTORE_DATABASE=

# ── Archivos locales (modo en la máquina con Drive montado) ───────────────────
# Carpeta "Redes sociales" tal como la ve esta máquina (Drive para escritorio). Dentro va Piezas/<carpeta-de-la-pieza>/...
# Por defecto: G:/My Drive/Marketing/Redes sociales
RS=
# Repo/carpeta de tu sitio web (para previsualizar imágenes del blog y que dispatch/ lea tips y artículos). Por defecto ../sitio-web
SITE_REPO=

# ── Google Drive desde el servidor ───────────────────────────────────────────
# Lectura: cuenta de servicio con acceso de lector a la carpeta raíz. JSON en UNA línea, o ruta a un archivo fuera del repo. (SECRETO)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Escritura: una cuenta de servicio no tiene cuota y no puede crear archivos, así que se usa tu autorización OAuth.
# Cliente OAuth tipo "Aplicación de escritorio" (Google Cloud Console → APIs y servicios → Credenciales).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=         # (SECRETO)
# El token lo genera: node scripts/drive-authorize.mjs
GOOGLE_OAUTH_REFRESH_TOKEN=         # (SECRETO)
# ID de la carpeta raíz "Redes sociales" (lo que va después de /folders/ en su dirección; no es secreto)
DRIVE_ROOT_FOLDER_ID=
# Opcional: ID de la subcarpeta "Piezas" si no quieres que se busque por nombre
DRIVE_PIEZAS_FOLDER_ID=

# ── Meta (Instagram, Facebook) y Threads ─────────────────────────────────────
# developers.facebook.com → tu app. El ID es público; el secreto solo va aquí o en Secret Manager.
META_APP_ID=
META_APP_SECRET=                    # (SECRETO)
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
# ID numérico de tu Página de Facebook y su token de acceso de larga duración (scripts/programar-facebook.mjs, reconcile-estados.mjs)
META_PAGE_ID=
META_PAGE_TOKEN=                    # (SECRETO)
THREADS_APP_ID=
THREADS_APP_SECRET=                 # (SECRETO)
THREADS_REDIRECT_URI=http://localhost:3000/api/oauth/threads/callback
THREADS_USER_TOKEN=                 # (SECRETO)

# ── Bluesky (lo usan los scripts de scripts/ y dispatch/) ────────────────────
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=               # (SECRETO) contraseña de aplicación, no la de la cuenta

# ── IA para generar contenido (opcional) ─────────────────────────────────────
# Gemini (capa gratuita, clave de Google AI Studio) primero; Claude como respaldo cuando se agota
GEMINI_API_KEY=                     # (SECRETO)
ANTHROPIC_API_KEY=                  # (SECRETO)
# Tope mensual de gasto en Claude, en dólares (el flujo se pausa al alcanzarlo)
AI_CLAUDE_MONTHLY_CAP_USD=

# ── Producción ───────────────────────────────────────────────────────────────
# 1 = solo lectura: el middleware bloquea /api salvo la lectura de Drive. Ponlo en el servidor desplegado (docs/despliegue.md).
HUB_READONLY=
